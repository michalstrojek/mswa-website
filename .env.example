# Copy to `.env.local` for local Next.js builds that need the Turnstile widget.
# Never commit real secrets. Cloudflare Pages Function secrets are set in the
# Cloudflare dashboard (Settings → Environment variables), not as NEXT_PUBLIC_*.

# Public site key (safe in the browser)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Cloudflare Pages Function secrets (dashboard only) ---
# RESEND_API_KEY=
# TURNSTILE_SECRET_KEY=

# Preview only (optional): comma-separated extra Origins allowed by /api/contact.
# Do NOT set wildcards. Production should omit this and keep defaults (mswa.pl).
# Example after a Preview URL exists:
# CONTACT_ALLOWED_ORIGINS=https://<hash>.mswa-website.pages.dev
