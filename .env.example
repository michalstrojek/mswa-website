# Copy to `.env.local` for local Next.js builds that need the Turnstile widget.
# Never commit real secrets. Cloudflare Pages Function secrets are set in the
# Cloudflare dashboard (Settings → Environment variables), not as NEXT_PUBLIC_*.

# Public site key (safe in the browser)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Cloudflare Pages Function secrets (dashboard only) ---
# RESEND_API_KEY=
# TURNSTILE_SECRET_KEY=

# --- Preview only (test/security-audit-fixes) — never set on Production ---
# CONTACT_ALLOWED_ORIGINS=https://test-security-audit-fixes.mswa-website.pages.dev
# CONTACT_DRY_RUN=true
# CONTACT_DRY_RUN_BRANCH=test/security-audit-fixes
# Official Turnstile dummy keys (always pass) for Preview testing:
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Do not set RESEND_API_KEY on Preview when using CONTACT_DRY_RUN.
